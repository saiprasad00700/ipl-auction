/* Modified from the upstream project by saiprasad00700. */
{
  "rules": {
    /*
      IPL Auction - Realtime Database security rules
      -----------------------------------------------------------------
      Threat model: the tree holds live, in-progress auction state for every
      room. The public internet must never be able to read, tamper with, or
      delete a room. Every request must be authenticated.

      How the app uses the tree (src/contexts/AuctionContext.jsx):
        auctions/{roomId}/room            host creates; any room member updates
                                          players/status; host-only for rules/bans
        auctions/{roomId}/live            host starts a lot; ANY member may bid
                                          and may close an expired lot (fallback)
        auctions/{roomId}/playerOrder     host only (start auction)
        auctions/{roomId}/messages        chat + system sale logs (any member)
        auctions/{roomId}/teams/{id}      per-team roster/purse, synced by clients
        auctions/{roomId}/presence/{uid}  per-user online flag
    */
    ".read": false,
    ".write": false,

    "publicRooms": {
      // This node contains only minimal directory metadata, never live auction data.
      ".read": true,
      ".write": false,
      "$roomId": {
        ".write": "auth != null && root.child('auctions').child($roomId).child('room/hostId').val() == auth.uid && root.child('auctions').child($roomId).child('room/isPublic').val() == true",
        ".validate": "!newData.exists() || (newData.hasChildren(['roomId', 'hostId', 'hostName', 'status', 'auctionType']) && newData.child('roomId').val() == $roomId && newData.child('hostId').val() == root.child('auctions').child($roomId).child('room/hostId').val() && newData.child('hostName').isString() && (newData.child('status').val() == 'waiting' || newData.child('status').val() == 'active'))",
        "roomId": { ".validate": "newData.isString()" },
        "hostId": { ".validate": "newData.isString()" },
        "hostName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "status": { ".validate": "newData.val() == 'waiting' || newData.val() == 'active'" },
        "auctionType": { ".validate": "newData.val() == 'mega' || newData.val() == 'sprint11' || newData.val() == 'sprint5'" },
        "createdAt": { ".validate": "newData.isNumber()" }
      }
    },

    "userAuctionHistory": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$roomId": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "!newData.exists() || (newData.hasChildren(['roomId', 'userId', 'mode', 'status']) && newData.child('roomId').val() == $roomId && newData.child('userId').val() == $uid && (newData.child('mode').val() == 'mega' || newData.child('mode').val() == 'sprint11' || newData.child('mode').val() == 'sprint5'))"
        }
      }
    },

    "auctions": {
      // Do not allow listing/enumerating rooms. A room is read by its id only.
      ".read": false,
      ".write": false,

      "$roomId": {
        // Any signed-in user who knows the 6-char room code can join/read it.
        ".read": "auth != null",

        /*
          Writing/deleting the WHOLE room node (i.e. resetting or deleting the
          room). Reserved for the host. Note: the client-side auto-cleanup that
          runs after a sale will simply no-op for non-hosts (it is wrapped in a
          try/catch); use scripts/cleanup-rtdb-auctions.js to purge old rooms.
        */
        ".write": "auth != null && data.child('room/hostId').val() == auth.uid",

        "room": {
          ".read": "auth != null",

          // Created by the host when the room node is empty; afterwards only the
          // host may replace the whole document.
          ".write": "auth != null && (!data.exists() || data.child('hostId').val() == auth.uid)",

          // Host identity can never change once set.
          "hostId": { ".validate": "newData.isString() && (!data.exists() || newData.val() == data.val())" },

          // Roster is updated by every member (join / team pick) and by the
          // client that settles a lot (spent / squadCount), so it stays open to
          // authenticated users. (RTDB rules cannot assert "is an array".)
          "players": { ".write": "auth != null" },

          // Activity heartbeat used by the scheduled 30-minute inactivity cleanup.
          "lastActivityAt": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },

          // Lot lifecycle. The host-fallback that closes an expired lot can run
          // on any client, so this cannot be host-only.
          "status": {
            // All lifecycle transitions are performed by host-authorized client actions
            // or trusted Admin SDK Cloud Functions. Never let a non-host client write
            // a status transition directly.
            ".write": "auth != null && root.child('auctions').child($roomId).child('room/hostId').val() == auth.uid",
            ".validate": "newData.val() == 'waiting' || newData.val() == 'active' || newData.val() == 'paused' || newData.val() == 'awaiting_xi' || newData.val() == 'analyzing' || newData.val() == 'analysis_failed' || newData.val() == 'completed'"
          },

          // Everything else under room (bannedPlayers, auctionType, isPublic,
          // settings, squad limits, playerOrder mirror, ...) inherits room.write
          // => host only.
        },

        "live": {
          // Bids are placed by any authenticated member; the lot may be closed by
          // any client once the server-verified timer has expired.
          ".write": "auth != null && ((!data.child('retentionOffer/decision').exists() && !newData.child('retentionOffer/decision').exists()) || (data.child('retentionOffer/decision').exists() && newData.child('retentionOffer/decision').val() == data.child('retentionOffer/decision').val()) || (!data.child('retentionOffer/decision').exists() && auth.uid == data.child('retentionOffer/eligibleUserId').val() && newData.child('retentionOffer/decision').exists() && newData.child('retentionOffer/decidedBy').val() == auth.uid) || (!data.child('retentionOffer/decision').exists() && auth.uid == root.child('auctions').child($roomId).child('room/hostId').val() && data.child('retentionOffer/eligibleUserId').val().beginsWith('bot_') && newData.child('retentionOffer/decision').exists() && newData.child('retentionOffer/decidedBy').val() == auth.uid) || (data.child('retentionOffer/decision').val() == 'accept' && !newData.child('retentionOffer/decision').exists() && auth.uid == data.child('retentionOffer/buyerId').val() && data.child('retentionOffer/phase').val() == 'counter_bid' && newData.child('retentionOffer/phase').val() == 'match_decision' && newData.child('retentionOffer/counterBid').isNumber() && newData.child('retentionOffer/counterBid').val() > data.child('retentionOffer/bid').val()) || (data.child('retentionOffer/decision').val() == 'accept' && !newData.child('retentionOffer/decision').exists() && auth.uid == root.child('auctions').child($roomId).child('room/hostId').val() && data.child('retentionOffer/buyerId').val().beginsWith('bot_') && data.child('retentionOffer/phase').val() == 'counter_bid' && newData.child('retentionOffer/phase').val() == 'match_decision' && newData.child('retentionOffer/counterBid').isNumber() && newData.child('retentionOffer/counterBid').val() > data.child('retentionOffer/bid').val()))",
          ".validate": "newData.hasChildren(['status']) && (newData.child('status').val() == 'bidding' || newData.child('status').val() == 'sold' || newData.child('status').val() == 'unsold' || newData.child('status').val() == 'paused' || newData.child('status').val() == 'waiting' || newData.child('status').val() == 'processing_sale')",
          "status": {
            ".validate": "newData.val() == data.val() || data.val() != 'processing_sale' || now >= data.parent().child('retentionOffer/expiresAt').val() || data.parent().child('retentionOffer/decision').exists()"
          },
          "retentionOffer": {
            "playerId": { ".validate": "!data.exists() || newData.val() == data.val()" },
            "originalFranchiseId": { ".validate": "!data.exists() || newData.val() == data.val()" },
            "eligibleUserId": { ".validate": "!data.exists() || newData.val() == data.val()" },
            "eligibleTeamName": { ".validate": "!data.exists() || newData.val() == data.val()" },
            "decision": { ".validate": "!newData.exists() || newData.val() == 'accept' || newData.val() == 'decline' || newData.val() == 'match' || newData.val() == 'decline_counter'" },
            "decidedBy": { ".validate": "!data.exists() || newData.val() == data.val() || (newData.parent().child('phase').val() == 'match_decision' && auth.uid == newData.val() && auth.uid == data.parent().child('eligibleUserId').val()) || (auth.uid == newData.val() && auth.uid == root.child('auctions').child($roomId).child('room/hostId').val() && newData.parent().child('eligibleUserId').val().beginsWith('bot_')) },
            "decidedAt": { ".validate": "!data.exists() || newData.val() == data.val() || (newData.parent().child('phase').val() == 'match_decision' && newData.isNumber() && newData.val() >= data.val())" },
            "buyerId": { ".validate": "!data.exists() || newData.val() == data.val()" },
            "buyerTeamId": { ".validate": "!data.exists() || newData.val() == data.val()" },
            "buyerName": { ".validate": "!data.exists() || newData.val() == data.val()" },
            "bid": { ".validate": "!data.exists() || newData.val() == data.val()" },
            "expiresAt": { ".validate": "!data.exists() || newData.val() == data.val() || (data.parent().child('phase').val() == 'initial_decision' && newData.parent().child('phase').val() == 'counter_bid' && newData.parent().child('decision').val() == 'accept' && newData.isNumber() && newData.val() > data.val()) || (data.parent().child('phase').val() == 'counter_bid' && newData.parent().child('phase').val() == 'match_decision' && newData.parent().child('counterBid').isNumber() && newData.isNumber() && newData.val() > now && newData.val() <= now + 12000)" },
            "status": {
              ".validate": "!data.exists() || newData.val() == data.val() || now >= data.parent().child('expiresAt').val() || data.parent().child('decision').exists()"
            }
          }
        },

        // The shuffled auction order is produced by the host when starting.
        "playerOrder": {
          ".write": "auth != null && root.child('auctions').child($roomId).child('room/hostId').val() == auth.uid"
        },

        "messages": {
          ".write": "auth != null",
          "$messageId": {
            ".validate": "newData.hasChildren(['userId', 'userName', 'text', 'type', 'timestamp']) && newData.child('userId').isString() && newData.child('userName').isString() && newData.child('userName').val().length <= 80 && newData.child('text').isString() && newData.child('text').val().length <= 2000 && newData.child('type').isString() && newData.child('type').val().length <= 32 && newData.child('timestamp').isNumber()",
            "userId": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "userName": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "type": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "timestamp": { ".validate": "newData.isNumber()" }
          }
        },

        // Whole-tree team sync happens from every client on each sale.
        "teams": {
          ".write": "auth != null"
        },

        // A user may only write their own presence entry.
        "presence": {
          ".read": "auth != null",
          "$userId": {
            ".write": "auth != null && auth.uid == $userId"
          }
        }
      }
    }
  }
}
